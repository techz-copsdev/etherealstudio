PORT=4000
NODE_ENV=development

# SQLite for development. Swap to postgres for production:
# DATABASE_URL="postgresql://user:password@host:5432/showroom"
DATABASE_URL="file:./dev.db"

# Admin API auth (Bearer token).
ADMIN_TOKEN=change-me-to-a-strong-random-string

# WhatsApp number untuk CTA & notification (format internasional tanpa +).
WHATSAPP_NUMBER=628123456789

# CORS — frontend origin(s). Comma-separated list.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
