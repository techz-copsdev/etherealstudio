# ===== App ======
NEXT_PUBLIC_APP_MODE=cloud                 # local | cloud
NEXT_PUBLIC_BRAND_NAME=BulkOrder.
NEXT_PUBLIC_BRAND_TAGLINE=Solusi Belanja Grosir Mudah & Cepat via WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_ENABLE_LIVECHAT=true
NEXT_PUBLIC_ENABLE_TRACKING=true
NEXT_PUBLIC_DEFAULT_SHIPPING=20000
NEXT_PUBLIC_ADMIN_CODE=admin123

# ===== Supabase (cloud mode) =====
# Public keys (safe to expose in client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only secret (never expose). Used by API routes for writes / RLS-bypass.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Storage bucket name for product images
NEXT_PUBLIC_SUPABASE_BUCKET=products
