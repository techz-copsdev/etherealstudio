# App mode: "local" (file-based JSON) | "cloud" (Supabase)
NEXT_PUBLIC_APP_MODE=local

# Branding
NEXT_PUBLIC_BRAND_NAME=UMKM Grosir
NEXT_PUBLIC_BRAND_TAGLINE=Pesan grosir cepat, checkout langsung via WhatsApp

# WhatsApp number used for checkout & live chat (E.164, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Feature flags
NEXT_PUBLIC_ENABLE_LIVECHAT=true
NEXT_PUBLIC_ENABLE_TRACKING=true

# Default shipping cost when region is missing (IDR)
NEXT_PUBLIC_DEFAULT_SHIPPING=20000

# Lightweight admin gate (NOT real auth — front with reverse proxy in prod)
NEXT_PUBLIC_ADMIN_CODE=admin123

# --- Cloud mode (optional) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Optional WhatsApp Business API layer (server-only) ---
# When unset, checkout always uses wa.me directly.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Optional courier tracking APIs (server-only) ---
# When unset, tracking returns the documented fallback message.
JNE_API_URL=
JNE_API_TOKEN=
JNT_API_URL=
JNT_API_TOKEN=
ANTERAJA_API_URL=
ANTERAJA_API_TOKEN=
